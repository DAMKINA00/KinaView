<UserControl x:Class="KinaView.ComparePane"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:KinaView" AllowDrop="True" Drop="OnDrop" PreviewMouseDown="Activate" GotKeyboardFocus="FocusPane">
 <Border x:Name="Frame" BorderBrush="#49645B" BorderThickness="1" Margin="1">
  <Grid Background="#202020">
   <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <DockPanel Background="#292F37" LastChildFill="True">
    <CheckBox x:Name="Selection" Style="{DynamicResource PaneSelection}" DockPanel.Dock="Left" IsChecked="True" FontWeight="Bold" VerticalAlignment="Center" Margin="7,4,8,4"
     Checked="SelectionChanged" Unchecked="SelectionChanged" ToolTip="체크한 패널끼리 확대와 이동을 함께 적용"/>
    <Button Style="{DynamicResource PaneButton}" DockPanel.Dock="Right" Content="열기" Margin="2,4,6,4" Click="OpenClick" ToolTip="이 패널에 이미지 열기"/>
    <Button x:Name="Scale" Style="{DynamicResource PaneButton}" DockPanel.Dock="Right" Content="맞춤" MinWidth="48" Click="FitClick" ToolTip="선택한 패널 화면 맞춤"/>
    <TextBlock x:Name="Filename" Foreground="#C9D1DC" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="파일을 열거나 끌어 놓으세요"/>
   </DockPanel>
   <Grid Grid.Row="1" ClipToBounds="True">
    <ScrollViewer x:Name="Viewport" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" Focusable="False"
     SizeChanged="ViewportChanged" ScrollChanged="Scrolled" PreviewMouseWheel="Wheel" PreviewMouseLeftButtonDown="PanStart"
     PreviewMouseMove="PanMove" PreviewMouseLeftButtonUp="PanEnd" LostMouseCapture="PanLost">
     <Grid x:Name="Stage" Background="#202020">
      <Border Background="{DynamicResource Checker}" HorizontalAlignment="Center" VerticalAlignment="Center">
       <Image x:Name="Picture" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
      </Border>
     </Grid>
    </ScrollViewer>
    <TextBlock x:Name="Message" Text="파일을 끌어 놓으세요" Foreground="#BBBBBB" TextWrapping="Wrap" Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
     <Border x:Name="ComicStatus" Visibility="Collapsed" IsHitTestVisible="False" Background="#B82A3038" CornerRadius="4" Padding="9,5"
       HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,14">
      <TextBlock x:Name="ComicStatusText" Text="만화 보기 · 보정 중…" Foreground="#E8F2EE" FontSize="11"/>
     </Border>
    <Border x:Name="Info" Visibility="Collapsed" Background="#70000000" Padding="10" Margin="10" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
     <TextBlock x:Name="Details" Foreground="White" TextWrapping="Wrap"/>
    </Border>
    <local:OverviewMap x:Name="Overview"/>
   </Grid>
  </Grid>
 </Border>
</UserControl>
