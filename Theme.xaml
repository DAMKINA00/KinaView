<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Style TargetType="Button">
  <Setter Property="Background" Value="#E9EDF2"/><Setter Property="Foreground" Value="#27313D"/>
  <Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/>
  <Setter Property="Padding" Value="14,7"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
   <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
    <Grid>
     <Border x:Name="Hover" Background="White" Opacity="0" CornerRadius="4" Margin="-3"/>
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
    </Grid>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="0.10"/><Setter TargetName="Surface" Property="BorderBrush" Value="#778695"/></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="0.20"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#87B3F0"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="PaneButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
  <Setter Property="Background" Value="#343B44"/><Setter Property="Foreground" Value="#E5EAF0"/>
  <Setter Property="Padding" Value="9,3"/><Setter Property="Margin" Value="2,4"/><Setter Property="FontSize" Value="11"/>
 </Style>
 <Style x:Key="PaneSelection" TargetType="CheckBox">
  <Setter Property="Foreground" Value="#B8C2CD"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
   <Border x:Name="Badge" Background="#30363F" BorderBrush="#4A535F" BorderThickness="1" CornerRadius="5" Padding="6,3">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Path x:Name="Check" Data="M 0 4 L 3 7 L 9 0" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5" Width="9" Height="8" Margin="0,0,5,0" Visibility="Hidden"/>
     <ContentPresenter RecognizesAccessKey="True"/>
    </StackPanel>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Badge" Property="Background" Value="#2C4841"/><Setter TargetName="Badge" Property="BorderBrush" Value="#527B6D"/><Setter Property="Foreground" Value="#C1ECDA"/><Setter TargetName="Check" Property="Visibility" Value="Visible"/></Trigger>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Badge" Property="BorderBrush" Value="#A0B8B2"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Badge" Property="BorderBrush" Value="#87B3F0"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Badge" Property="Opacity" Value="0.4"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="MenuItem">
  <Setter Property="Foreground" Value="#35404D"/><Setter Property="Padding" Value="10,6"/>
  <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
   <Grid>
    <Border x:Name="Surface" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}" Margin="1">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition x:Name="CheckColumn" Width="0"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition x:Name="ArrowColumn" Width="0"/></Grid.ColumnDefinitions>
      <Path x:Name="CheckedMark" Data="M 0 4 L 3 7 L 9 0" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5" Width="9" Height="8" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed"/>
      <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
      <TextBlock x:Name="Gesture" Grid.Column="2" Text="{TemplateBinding InputGestureText}" Opacity="0.62" VerticalAlignment="Center"/>
      <Path x:Name="Arrow" Grid.Column="3" Data="M 0 0 L 4 4 L 0 8" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.2" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed"/>
     </Grid>
    </Border>
    <Popup x:Name="PART_Popup" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
     <Border Background="#FAFBFC" BorderBrush="#D6DCE4" BorderThickness="1" CornerRadius="7" Padding="4" MinWidth="220">
      <ScrollViewer CanContentScroll="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
       <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Cycle"/>
      </ScrollViewer>
     </Border>
    </Popup>
   </Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="Role" Value="TopLevelHeader"><Setter Property="Padding" Value="9,5"/></Trigger>
    <Trigger Property="Role" Value="TopLevelItem"><Setter Property="Padding" Value="9,5"/></Trigger>
    <Trigger Property="Role" Value="SubmenuItem"><Setter TargetName="CheckColumn" Property="Width" Value="20"/><Setter TargetName="Gesture" Property="Margin" Value="18,0,0,0"/></Trigger>
    <Trigger Property="Role" Value="SubmenuHeader"><Setter TargetName="CheckColumn" Property="Width" Value="20"/><Setter TargetName="ArrowColumn" Property="Width" Value="16"/><Setter TargetName="Arrow" Property="Visibility" Value="Visible"/><Setter TargetName="PART_Popup" Property="Placement" Value="Right"/></Trigger>
    <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Surface" Property="Background" Value="#E5EAF0"/></Trigger>
    <Trigger Property="IsSubmenuOpen" Value="True"><Setter TargetName="Surface" Property="Background" Value="#E1E7EF"/></Trigger>
    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="Background" Value="#DCEBE5"/></Trigger>
    <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsChecked" Value="True"/><Condition Property="Role" Value="SubmenuItem"/></MultiTrigger.Conditions><Setter TargetName="CheckedMark" Property="Visibility" Value="Visible"/></MultiTrigger>
    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.38"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="Separator">
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator"><Border Height="1" Background="#E2E6EC" Margin="10,5"/></ControlTemplate></Setter.Value></Setter>
 </Style>
</ResourceDictionary>
